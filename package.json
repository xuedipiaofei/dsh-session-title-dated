{
  "name": "dsh-session-title-stamp",
  "version": "0.4.2",
  "description": "DSH session titles in a DATE | CATEGORY | NAME template, with turn-aware auto-generation, a Generate title button, and hover cost/duration.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-title",
    "naming",
    "productivity"
  ],
  "author": "xuedipiaofei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuedipiaofei/dsh-session-title-stamp.git"
  },
  "homepage": "https://github.com/xuedipiaofei/dsh-session-title-stamp#readme",
  "bugs": {
    "url": "https://github.com/xuedipiaofei/dsh-session-title-stamp/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "market/index.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-session-title-llm": "^0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --check client.js && node test/format.test.mjs && node test/provider.test.mjs && node test/client.test.mjs && node scripts/check.mjs",
    "check": "node scripts/check.mjs",
    "validate:index": "node scripts/validate-index.mjs",
    "pack:check": "npm pack --dry-run"
  }
}
